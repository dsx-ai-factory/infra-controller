#
# Periodically crictl-execs into a named container to read one file and
# writes it to a shared path. This is the only place in the punt-stats
# pipeline that needs containerd-socket / crictl exec access, so the
# general-purpose otelcol-contrib container (which reads PUNT_STATS_DST_PATH
# directly, no exec) never needs it.
set -euo pipefail

: "${PUNT_STATS_CONTAINER_NAME:?PUNT_STATS_CONTAINER_NAME must be set}"
: "${PUNT_STATS_SRC_PATH:?PUNT_STATS_SRC_PATH must be set}"
: "${PUNT_STATS_DST_PATH:?PUNT_STATS_DST_PATH must be set}"
: "${PUNT_STATS_INTERVAL_SECONDS:=60}"

while true; do
  # Match on the JSON name field, not crictl ps --name (substring match), so
  # a container whose name merely contains PUNT_STATS_CONTAINER_NAME isn't
  # picked.
  container_id=$(crictl ps -o json \
      | jq -r --arg name "${PUNT_STATS_CONTAINER_NAME}" \
          '.containers[] | select(.metadata.name == $name) | .id' \
      | head -n1)

  if [[ -n "${container_id}" ]]; then
    if crictl exec "${container_id}" cat "${PUNT_STATS_SRC_PATH}" > "${PUNT_STATS_DST_PATH}.tmp" 2>/dev/null; then
      mv "${PUNT_STATS_DST_PATH}.tmp" "${PUNT_STATS_DST_PATH}"
    else
      echo "WARN: failed to read ${PUNT_STATS_SRC_PATH} from container ${PUNT_STATS_CONTAINER_NAME}" >&2
    fi
  else
    echo "WARN: container ${PUNT_STATS_CONTAINER_NAME} not found" >&2
  fi

  sleep "${PUNT_STATS_INTERVAL_SECONDS}"
done
