 /**
+ * Optional HTTP IPv6 source, in address%interface form.
+ *
+ * The address must belong to the interface.  When set, HTTP and HTTPS
+ * connections require an IPv6 destination; clearing it restores automatic
+ * source selection.  Existing connections retain their original binding.
+ */
+static const struct setting http_source6_setting
+	__setting ( SETTING_MISC, http_source6 ) = {
+	.name = "http-source6",
+	.description = "HTTP IPv6 source address%interface",
+	.type = &setting_type_string,
+};
+
+/**
+ * Read the HTTP source binding before opening or reusing a connection.
+ *
+ * @v local		Local socket address to fill in
+ * @ret rc		Return status code
+ */
+static int http_source6 ( struct sockaddr_tcpip *local ) {
+#ifdef NET_PROTO_IPV6
+	struct sockaddr_in6 *sin6 = ( ( struct sockaddr_in6 * ) local );
+	struct net_device *netdev;
+#endif
+	char *source;
+	int rc;
+
+	memset ( local, 0, sizeof ( *local ) );
+	rc = fetch_string_setting_copy ( NULL, &http_source6_setting, &source );
+	/* Ignore the originating file and per-file error disambiguator. */
+	if ( ( -rc & 0x7f0000ff ) == ( ENOENT & 0x7f0000ff ) )
+		return 0;
+	if ( rc < 0 )
+		return rc;
+	rc = sock_aton ( source, ( ( struct sockaddr * ) local ) );
+	free ( source );
+	if ( rc != 0 )
+		return rc;
+
+#ifdef NET_PROTO_IPV6
+	if ( ( local->st_family != AF_INET6 ) || ! local->st_scope_id ||
+	     IN6_IS_ADDR_UNSPECIFIED ( &sin6->sin6_addr ) ||
+	     IN6_IS_ADDR_MULTICAST ( &sin6->sin6_addr ) )
+		return -EINVAL;
+	netdev = find_netdev_by_scope_id ( local->st_scope_id );
+	if ( ! netdev || ! netdev_is_open ( netdev ) ||
+	     ! ipv6_has_addr ( netdev, &sin6->sin6_addr ) )
+		return -EADDRNOTAVAIL;
+	return 0;
+#else
+	return -ENOTSUP;
+#endif
+}
