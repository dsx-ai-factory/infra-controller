+/**
+ * Capture the source selected by HTTP, TCP, and IPv6 together.
+ *
+ * Only DNS replies are simulated: stop at the first TCP SYN and abort the
+ * connection before it can enter the HTTP connection pool.
+ */
+static int http_source_transmit ( struct net_device *netdev,
+				  struct io_buffer *iobuf ) {
+	struct ethhdr *eth = iobuf->data;
+	struct ipv6_header *ip = ( ( void * ) ( eth + 1 ) );
+	struct tcp_header *tcp = ( ( void * ) ( ip + 1 ) );
+
+	if ( ( iob_len ( iobuf ) >=
+	       ( sizeof ( *eth ) + sizeof ( *ip ) + sizeof ( *tcp ) ) ) &&
+	     ( eth->h_protocol == htons ( ETH_P_IPV6 ) ) &&
+	     ( ip->next_header == IP_TCP ) &&
+	     ( memcmp ( &ip->dest, &http_syn.dest,
+			sizeof ( ip->dest ) ) == 0 ) &&
+	     ( tcp->dest == htons ( HTTP_PORT ) ) &&
+	     ( tcp->flags & TCP_SYN ) && ! http_syn.count ) {
+		memcpy ( &http_syn.source, &ip->src, sizeof ( ip->src ) );
+		http_syn.count++;
+	}
+	http_dns_reply ( netdev, iobuf );
+	netdev_tx_complete ( netdev, iobuf );
+	return 0;
+}
+
+/* IPv4 DNS transport must still resolve an IPv6-bound HTTP connection using
+ * AAAA.  The second case has no AAAA or CNAME: it must fail without querying A.
+ */
+static void http_dns_test_exec ( const struct setting *source6,
+				 const uint8_t *peer_mac ) {
+	static const struct {
+		const char *uri;
+		const char *target;
+	} cases[] = {
+		{ "http://alias.example.test/", "target.example.test" },
+		{ "http://v4only.example.test/", NULL },
+	};
+	const struct setting *settings[] = { &dns_setting, &dns6_setting };
+	struct {
+		struct settings *origin;
+		struct setting setting;
+		void *value;
+		int len;
+	} saved[2] = { { 0 } };
+	struct settings *local = netdev_settings ( httptest.netdev );
+	struct in_addr server;
+	struct in6_addr expected;
+	struct uri *uri;
+	unsigned int saved_count = 0;
+	unsigned int i;
+	unsigned int steps;
+	int rc;
+
+	/* Remove only the effective DNS values and restore them below.  A second
+	 * inherited value would make the fixture's DNS transport ambiguous.
+	 */
+	for ( i = 0 ; i < 2 ; i++ ) {
+		saved[i].len = fetch_setting_copy ( NULL, settings[i], &saved[i].origin,
+						   &saved[i].setting, &saved[i].value );
+		saved_count++;
+		ok ( ( saved[i].len >= 0 ) || http_source_missing ( saved[i].len ) );
+		if ( ( saved[i].len < 0 ) && ! http_source_missing ( saved[i].len ) )
+			goto restore;
+		if ( saved[i].len >= 0 ) {
+			rc = delete_setting ( saved[i].origin, &saved[i].setting );
+			ok ( rc == 0 );
+			if ( rc != 0 )
+				goto restore;
+		}
+		rc = fetch_raw_setting ( NULL, settings[i], NULL, 0 );
+		ok ( http_source_missing ( rc ) );
+		if ( ! http_source_missing ( rc ) )
+			goto restore;
+	}
+	rc = storef_setting ( local, &dns_setting, "192.0.2.53" );
+	ok ( rc == 0 );
+	if ( rc != 0 )
+		goto restore;
+	rc = storef_setting ( local, source6, "2001:db8:7172:1::10%httptest" );
+	ok ( rc == 0 );
+	if ( rc != 0 )
+		goto restore;
+	ok ( inet_aton ( "192.0.2.53", &server ) != 0 );
+	ok ( inet6_aton ( "2001:db8:7172:1::10", &expected ) == 0 );
+	rc = neighbour_define ( httptest.netdev, &ipv4_protocol, &server, peer_mac );
+	ok ( rc == 0 );
+	if ( rc != 0 )
+		goto restore;
+	rc = neighbour_define ( httptest.netdev, &ipv6_protocol,
+				&http_syn.dest, peer_mac );
+	ok ( rc == 0 );
+	if ( rc != 0 )
+		goto restore;
+
+	for ( i = 0 ; i < ( sizeof ( cases ) / sizeof ( cases[0] ) ) ; i++ ) {
+		DBG ( "HTTP DNS resolving %s\n", cases[i].uri );
+		uri = parse_uri ( cases[i].uri );
+		ok ( uri != NULL );
+		if ( ! uri )
+			break;
+		memset ( &http_dns, 0, sizeof ( http_dns ) );
+		http_dns.name = uri->host;
+		http_dns.target = cases[i].target;
+		http_dns.server = server;
+		http_syn.count = 0;
+		intf_init ( &http_dns.xfer, &http_dns_desc, NULL );
+		rc = http_connect ( &http_dns.xfer, uri );
+		ok ( rc == 0 );
+		if ( rc == 0 ) {
+			for ( steps = 0 ; ( steps < 1024 ) && ! http_syn.count &&
+			      ! http_dns.closed && ! http_dns.failed ; steps++ )
+				step();
+			ok ( ! http_dns.failed );
+			ok ( http_dns.queries == 2 );
+			if ( cases[i].target ) {
+				ok ( ! http_dns.closed );
+				ok ( http_syn.count == 1 );
+				ok ( memcmp ( &http_syn.source, &expected,
+					      sizeof ( expected ) ) == 0 );
+			} else {
+				ok ( http_dns.closed && ( http_dns.status < 0 ) );
+				ok ( http_syn.count == 0 );
+			}
+		}
+		intf_shutdown ( &http_dns.xfer, -ECANCELED );
+		http_dns.name = NULL;
+		uri_put ( uri );
+	}
+ restore:
+	ok ( delete_setting ( local, &dns_setting ) == 0 );
+	for ( i = 0 ; i < saved_count ; i++ ) {
+		if ( saved[i].len >= 0 ) {
+			ok ( store_setting ( saved[i].origin, &saved[i].setting,
+					     saved[i].value, saved[i].len ) == 0 );
+		}
+		free ( saved[i].value );
+	}
+}
+
+/**
+ * A stateful lease must remain the HTTP source when another local prefix
+ * contains the server.  Without the opt-in, normal source selection must
+ * still choose that on-link prefix's address.
+ * Invalid bindings must fail before opening a connection.
+ */
+static void http_source_test_exec ( void ) {
+	static const struct {
+		const char *binding;
+		/* Expected source, or `NULL` if opening must fail. */
+		const char *source;
+	} cases[] = {
+		/* Keep the recorded lease even though the route supplies SLAAC. */
+		{ "2001:db8:7172:1::10%httptest", "2001:db8:7172:1::10" },
+		/* Clearing the opt-in restores the route's normal source. */
+		{ NULL, "2001:db8:7172:2::10" },
+		/* An unspecified source must not request automatic selection. */
+		{ "::%httptest", NULL },
+		/* A parsed source must still belong to the selected interface. */
+		{ "2001:db8:7172:1::99%httptest", NULL },
+	};
+	static const uint8_t peer_mac[ETH_ALEN] = { 2, 0, 0, 0, 0, 0x80 };
+	const struct setting *source6 = find_setting ( "http-source6" );
+	struct settings *saved_origin;
+	struct setting saved_setting;
+	void *saved_value;
+	int saved_len;
+	struct net_device_operations operations;
+	struct net_device_operations *saved_operations;
+	struct interface xfer;
+	struct uri *uri;
+	struct in6_addr expected;
+	unsigned int i;
+	unsigned int steps;
+	int rc;
+
+	ok ( source6 != NULL );
+	if ( ! source6 )
+		return;
+
+	/* Restore an existing binding to its original settings block.  A
+	 * second inherited binding would invalidate the unbound control, so
+	 * report it as a failed precondition rather than changing it too.
+	 */
+	saved_len = fetch_setting_copy ( NULL, source6, &saved_origin,
+					 &saved_setting, &saved_value );
+	ok ( ( saved_len >= 0 ) || http_source_missing ( saved_len ) );
+	if ( ( saved_len < 0 ) && ! http_source_missing ( saved_len ) )
+		return;
+	if ( saved_len >= 0 ) {
+		rc = delete_setting ( saved_origin, &saved_setting );
+		ok ( rc == 0 );
+		if ( rc != 0 )
+			goto restore;
+	}
+	rc = fetch_raw_setting ( NULL, source6, NULL, 0 );
+	ok ( http_source_missing ( rc ) );
+	if ( ! http_source_missing ( rc ) )
+		goto restore;
+
+	testnet_ok ( &httptest );
+	saved_operations = httptest.netdev->op;
+	memcpy ( &operations, saved_operations, sizeof ( operations ) );
+	operations.transmit = http_source_transmit;
+	httptest.netdev->op = &operations;
+	ok ( inet6_aton ( "2001:db8:7172:2::80", &http_syn.dest ) == 0 );
+	uri = parse_uri ( "http://[2001:db8:7172:2::80]/" );
+	ok ( uri != NULL );
+	if ( ! uri )
+		goto remove;
+
+	for ( i = 0 ; i < ( sizeof ( cases ) / sizeof ( cases[0] ) ) ; i++ ) {
+		DBG ( "HTTP source binding %s expects %s\n",
+		      ( cases[i].binding ? cases[i].binding : "<unset>" ),
+		      ( cases[i].source ? cases[i].source : "<rejected>" ) );
+		if ( cases[i].binding ) {
+			rc = storef_setting ( netdev_settings ( httptest.netdev ),
+					      source6, cases[i].binding );
+		} else {
+			rc = delete_setting ( netdev_settings ( httptest.netdev ),
+					      source6 );
+		}
+		ok ( rc == 0 );
+		if ( rc != 0 )
+			break;
+		if ( cases[i].source )
+			ok ( inet6_aton ( cases[i].source, &expected ) == 0 );
+
+		/* Resolve only the link-layer neighbour, leaving source and
+		 * route selection to the production stack.
+		 */
+		rc = neighbour_define ( httptest.netdev, &ipv6_protocol,
+					&http_syn.dest, peer_mac );
+		ok ( rc == 0 );
+		if ( rc != 0 )
+			break;
+		http_syn.count = 0;
+		intf_init ( &xfer, &null_intf_desc, NULL );
+		rc = http_connect ( &xfer, uri );
+		if ( ! cases[i].source ) {
+			ok ( rc < 0 );
+			ok ( http_syn.count == 0 );
+		} else {
+			ok ( rc == 0 );
+		}
+		if ( ( rc == 0 ) && cases[i].source ) {
+			/* Numeric resolution and the first SYN are scheduled work.
+			 * A missing packet must fail, not hang or skip the assertion.
+			 */
+			for ( steps = 0 ; ( steps < 1024 ) && ! http_syn.count ;
+			      steps++ )
+				step();
+			ok ( http_syn.count == 1 );
+			if ( http_syn.count ) {
+				ok ( memcmp ( &http_syn.source, &expected,
+					      sizeof ( expected ) ) == 0 );
+			}
+		}
+		intf_shutdown ( &xfer, -ECANCELED );
+	}
+	http_dns_test_exec ( source6, peer_mac );
+	uri_put ( uri );
+ remove:
+	httptest.netdev->op = saved_operations;
+	testnet_remove_ok ( &httptest );
+ restore:
+	if ( saved_len >= 0 ) {
+		ok ( store_setting ( saved_origin, &saved_setting, saved_value,
+				     saved_len ) == 0 );
+	}
+	free ( saved_value );
+}
+
+/** HTTP IPv6 source selection self-test */
+struct self_test http_source_test __self_test = {
+	.name = "http_source",
+	.exec = http_source_test_exec,
+};
