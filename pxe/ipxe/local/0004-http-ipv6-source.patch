+
+/* Only the active DNS case receives replies.  Its HTTP connection is stopped
+ * at the first SYN, or when resolution reports failure.
+ */
+static struct http_dns_test {
+	struct interface xfer;
+	const char *name;
+	const char *target;
+	struct in_addr server;
+	unsigned int queries;
+	int closed;
+	int status;
+	int failed;
+} http_dns;
+
+/* Cleanup cancellation must not stand in for an observed lookup failure. */
+static void http_dns_close ( struct http_dns_test *test, int rc ) {
+	test->closed = 1;
+	test->status = rc;
+	intf_shutdown ( &test->xfer, rc );
+}
+
+static struct interface_operation http_dns_operations[] = {
+	INTF_OP ( intf_close, struct http_dns_test *, http_dns_close ),
+};
+
+static struct interface_descriptor http_dns_desc =
+	INTF_DESC ( struct http_dns_test, xfer, http_dns_operations );
+
+/** Match an absent setting independently of the file returning the error. */
+static int http_source_missing ( int rc ) {
+	return ( ( -rc & 0x7f0000ff ) == ( ENOENT & 0x7f0000ff ) );
+}
+
+/* Each answer names the copied question, using its DNS compression offset. */
+static void http_dns_answer ( struct io_buffer *reply, struct dns_header *dns,
+			      unsigned int type, const void *data, size_t len ) {
+	uint16_t owner = htons ( 0xc000 | sizeof ( *dns ) );
+	struct dns_rr_common *rr;
+
+	memcpy ( iob_put ( reply, sizeof ( owner ) ), &owner, sizeof ( owner ) );
+	rr = iob_put ( reply, sizeof ( *rr ) );
+	memset ( rr, 0, sizeof ( *rr ) );
+	rr->type = htons ( type );
+	rr->class = htons ( DNS_CLASS_IN );
+	rr->rdlength = htons ( len );
+	memcpy ( iob_put ( reply, len ), data, len );
+	dns->ancount = htons ( ntohs ( dns->ancount ) + 1 );
+}
+
+/* Answer two fixed DNS exchanges over IPv4.  Queue replies through the real
+ * receive path so a reply cannot reenter the resolver while it sends a query.
+ */
+static void http_dns_reply ( struct net_device *netdev,
+			     struct io_buffer *iobuf ) {
+	struct ethhdr *eth = iobuf->data;
+	struct iphdr *ip = ( ( void * ) ( eth + 1 ) );
+	struct udp_header *udp = ( ( void * ) ( ip + 1 ) );
+	struct dns_header *dns = ( ( void * ) ( udp + 1 ) );
+	struct dns_question *question;
+	struct dns_name name;
+	struct io_buffer *reply = NULL;
+	struct ethhdr *reply_eth;
+	struct iphdr *reply_ip;
+	struct udp_header *reply_udp;
+	struct dns_header *reply_dns;
+	struct in_addr ipv4;
+	char decoded[DNS_MAX_NAME_LEN + 1];
+	const char *expected;
+	size_t prefix = ( sizeof ( *eth ) + sizeof ( *ip ) + sizeof ( *udp ) );
+	size_t udp_len;
+	unsigned int query = http_dns.queries;
+	unsigned int type;
+	int offset;
+	int len;
+	int valid;
+
+	if ( ! http_dns.name || ( iob_len ( iobuf ) < prefix + sizeof ( *dns ) ) ||
+	     ( eth->h_protocol != htons ( ETH_P_IP ) ) ||
+	     ( ip->protocol != IP_UDP ) || ( udp->dest != htons ( DNS_PORT ) ) )
+		return;
+	udp_len = ntohs ( udp->len );
+	valid = ( ( query < 2 ) &&
+		  ( ip->verhdrlen == ( IP_VER | ( sizeof ( *ip ) / 4 ) ) ) &&
+		  ( ip->dest.s_addr == http_dns.server.s_addr ) &&
+		  ( udp_len >= sizeof ( *udp ) + sizeof ( *dns ) ) &&
+		  ( prefix + udp_len - sizeof ( *udp ) <= iob_len ( iobuf ) ) &&
+		  ( dns->qdcount == htons ( 1 ) ) );
+	ok ( valid );
+	if ( ! valid )
+		goto fail;
+	name.data = dns;
+	name.offset = sizeof ( *dns );
+	name.len = ( udp_len - sizeof ( *udp ) );
+	offset = dns_skip ( &name );
+	valid = ( ( offset >= 0 ) &&
+		  ( offset + sizeof ( *question ) <= name.len ) );
+	ok ( valid );
+	if ( ! valid )
+		goto fail;
+	question = ( ( ( void * ) dns ) + offset );
+	len = dns_decode ( &name, decoded, sizeof ( decoded ) );
+	expected = ( ( http_dns.target && query ) ?
+		     http_dns.target : http_dns.name );
+	type = ( ( ! http_dns.target && query ) ? DNS_TYPE_CNAME : DNS_TYPE_AAAA );
+	valid = ( ( len >= 0 ) && ( ( size_t ) len < sizeof ( decoded ) ) &&
+		  ( strcmp ( decoded, expected ) == 0 ) &&
+		  ( question->qtype == htons ( type ) ) &&
+		  ( question->qclass == htons ( DNS_CLASS_IN ) ) );
+	ok ( valid );
+	if ( ! valid )
+		goto fail;
+	http_dns.queries++;
+	DBG ( "HTTP DNS query %d: %s type %d\n", ( int ) query, decoded, ( int ) type );
+
+	/* The fixed names and at most two answers fit in one Ethernet frame. */
+	reply = alloc_iob ( ETH_FRAME_LEN );
+	ok ( reply != NULL );
+	if ( ! reply )
+		goto fail;
+	memcpy ( iob_put ( reply, prefix + offset + sizeof ( *question ) ),
+		 iobuf->data, prefix + offset + sizeof ( *question ) );
+	reply_eth = reply->data;
+	reply_ip = ( ( void * ) ( reply_eth + 1 ) );
+	reply_udp = ( ( void * ) ( reply_ip + 1 ) );
+	reply_dns = ( ( void * ) ( reply_udp + 1 ) );
+	reply_dns->flags = htons ( 0x8180 ); /* Response, recursion, NOERROR */
+	reply_dns->ancount = reply_dns->nscount = reply_dns->arcount = 0;
+	if ( http_dns.target && ! query ) {
+		name.data = decoded;
+		name.offset = 0;
+		name.len = sizeof ( decoded );
+		len = dns_encode ( http_dns.target, &name );
+		valid = ( ( len > 0 ) && ( ( size_t ) len <= sizeof ( decoded ) ) );
+		ok ( valid );
+		if ( ! valid )
+			goto fail;
+		http_dns_answer ( reply, reply_dns, DNS_TYPE_CNAME, decoded, len );
+	} else if ( http_dns.target ) {
+		/* An A answer before AAAA must not override the IPv6 binding. */
+		ok ( inet_aton ( "192.0.2.80", &ipv4 ) != 0 );
+		http_dns_answer ( reply, reply_dns, DNS_TYPE_A,
+				  &ipv4, sizeof ( ipv4 ) );
+		http_dns_answer ( reply, reply_dns, DNS_TYPE_AAAA,
+				  &http_syn.dest, sizeof ( http_syn.dest ) );
+	}
+	memcpy ( reply_eth->h_dest, eth->h_source, ETH_ALEN );
+	memcpy ( reply_eth->h_source, eth->h_dest, ETH_ALEN );
+	reply_ip->src = ip->dest;
+	reply_ip->dest = ip->src;
+	reply_ip->len = htons ( iob_len ( reply ) - sizeof ( *eth ) );
+	reply_ip->chksum = 0;
+	reply_ip->chksum = tcpip_chksum ( reply_ip, sizeof ( *reply_ip ) );
+	reply_udp->src = udp->dest;
+	reply_udp->dest = udp->src;
+	reply_udp->len = htons ( iob_len ( reply ) - prefix + sizeof ( *udp ) );
+	reply_udp->chksum = 0; /* Valid for this IPv4 response. */
+	netdev_rx ( netdev, iob_disown ( reply ) );
+	return;
+ fail:
+	http_dns.failed = 1;
+	free_iob ( reply );
+}
