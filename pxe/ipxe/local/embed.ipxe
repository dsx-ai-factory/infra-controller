#!ipxe

set esc:hex 1b
set bold ${esc:string}[1m
set boldoff ${esc:string}[22m

set white ${esc:string}[37m

#color --rgb 0x76b900 7
#cpair --foreground 7 --background 9 0

:start
echo ${bold}${white}NICo${boldoff} - ${version}
prompt --key p --timeout 4000 Hit the ${bold}p${boldoff} key to open NICo menu... && goto nico_menu || goto nico

:whoami
set nico-after-network whoami_ready
goto configure_network

:whoami_ready
time chain --autofree ${nico-pxe-base}/api/v0/pxe/whoami
goto nico_menu

:nico
set nico-after-network nico_ready
goto configure_network

:nico_ready
imgfree nico-boot ||
set nico-retry-provisioning 0
time chain --name nico-boot ${nico-pxe-base}/api/v0/pxe/boot?buildarch=${buildarch}&platform=${platform}&manufacturer=${manufacturer}&product=${product}&serial=${serial} && exit 1 || goto retry_nico_boot

# Core sets this flag to 1 when the response consumes a one-time custom PXE request.
:retry_nico_boot
iseq ${nico-retry-provisioning} 1 || goto error_handler
imgstat nico-boot || goto error_handler
prompt --key p --timeout 30000 Hit the ${bold}p${boldoff} key to open NICo menu; retrying in 30 seconds... && goto nico_menu ||
time imgexec nico-boot && exit 1 || goto retry_nico_boot

:configure_network
# This configuration pass can switch families; clear any previous HTTP binding.
clear http-source6
# Try DHCPv4 first to preserve the boot path on dual-stack networks.
ifconf -c dhcp || goto configure_ipv6
# NICo's DHCPv4 boot endpoint uses the standard HTTP port (80).
set nico-pxe-base http://${next-server}
goto ${nico-after-network}

:configure_ipv6
# Without a configured network, return to firmware instead of retrying a fetch.
ifconf -c ipv6 || exit 1
# Core must have registered the exact HTTP source address.
# Prefer the lease: stateful allocation replaces Core's inferred SLAAC address.
isset ${netX.dhcpv6/ip6} || goto configure_slaac
set http-source6 ${netX.dhcpv6/ip6}%${netX/ifname}
goto ipv6_ready

:configure_slaac
# Core can infer iPXE's EUI-64 address from a relayed Information-Request
# on opted-in segments.
# Use NDP settings explicitly; generic `ip6` can select a link-local address.
isset ${netX.ndp/ip6} || goto missing_ipv6_address
set http-source6 ${netX.ndp/ip6}%${netX/ifname}

:ipv6_ready
isset ${cwuri} || goto missing_boot_uri
# The server named by `cwuri` must also serve `/api/v0/pxe/`. An empty base
# reuses that URI's scheme, server, and port.
clear nico-pxe-base
goto ${nico-after-network}

:missing_ipv6_address
echo NICo IPv6 boot requires a DHCPv6 lease or SLAAC address.
exit 1

:missing_boot_uri
echo NICo IPv6 boot requires an inherited HTTP boot URI.
exit 1

:nico_menu
menu NICo - ${hostname}
item nico Boot according to NICo workflow
item whoami Print information about this machine
item localboot Boot to local drive
#item netconfig Manual network configuration
#item vlan Manual VLAN configuration
item retry Retry boot
item debug iPXE Debug Shell
item reboot Reboot System
choose --default nico --timeout 5000 target && goto ${target}
prompt --key p --timeout 4000 Hit the ${bold}p${boldoff} key to open NICo menu...
goto nico_menu

:localboot
exit

:retry
goto start

:error_handler
prompt --key p --timeout 4000 Hit the ${bold}p${boldoff} key to continue (4 seconds timeout)...
goto nico_menu

:debug
echo Type "exit" to return to menu
shell
goto nico_menu

:reboot
reboot
goto start
