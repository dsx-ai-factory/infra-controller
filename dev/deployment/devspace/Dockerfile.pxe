FROM build-container-localdev AS builder

ENV CARGO_HOME=/cargo-home
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true
ENV CARGO_TARGET_DIR=/cargo-target

WORKDIR /workspace
COPY . .

RUN --mount=type=cache,id=nico-devspace-cargo-home,target=/cargo-home,sharing=locked \
  --mount=type=cache,id=nico-devspace-cargo-target,target=/cargo-target,sharing=locked \
  cargo build -p carbide-pxe --bin carbide --locked && \
  mkdir -p /artifacts && \
  cp /cargo-target/debug/carbide /artifacts/carbide

FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 10001 nico \
  && useradd --uid 10001 --gid nico --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin nico \
  && install -d -o nico -g nico \
  /opt/carbide/pxe/templates \
  /opt/carbide/scout-firmware-scripts \
  /forge-boot-artifacts/blobs

COPY --chown=nico:nico --from=builder /artifacts/carbide /opt/carbide/carbide
COPY --chown=nico:nico pxe/templates/ /opt/carbide/pxe/templates/
COPY --chown=nico:nico pxe/scout-firmware-scripts/ /opt/carbide/scout-firmware-scripts/

USER 10001:10001
