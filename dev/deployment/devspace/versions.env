# shellcheck shell=bash
#
# Toolchain and image pins shared by the local DevSpace scripts in this
# directory. Sourced by bootstrap-prereqs.sh, setup-devspace-on-host.sh,
# prepare-ubuntu-host-for-dev.sh, and setup-devspace-mac-colima.sh. This file
# only assigns, so it is not executable.

DEVSPACE_VERSION="v6.3.21"
KIND_VERSION="v0.32.0"
KUBECTL_VERSION="v1.36.3"
HELM_VERSION="v3.21.3"
KIND_NODE_IMAGE="kindest/node:v1.36.1"

# CORE_POSTGRES_IMAGE is the tag bootstrap-prereqs.sh deploys, so the host
# setup scripts have to preload exactly it for the preload to be reused.
# REST_POSTGRES_IMAGE is the tag the REST migration manifests wait on, and the
# setup scripts alias it from the Core image instead of pulling it again.
CORE_POSTGRES_IMAGE="postgres:14.5-alpine"
REST_POSTGRES_IMAGE="postgres:14.4-alpine"
