            "axisBorderShow": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(namespace,instance) (tempo_live_store_live_traces{job=\"tempo\",namespace=~\"$namespace\",instance=~\"$instance\"}) / on(namespace,instance) max by(namespace,instance) (tempo_limits_defaults{job=\"tempo\",namespace=~\"$namespace\",instance=~\"$instance\",limit_name=\"max_local_traces_per_user\"} > 0)",
          "legendFormat": "{{instance}}",
          "range": true
