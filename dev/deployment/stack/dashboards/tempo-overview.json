    {
      "id": 19,
      "title": "Maintenance and remote-write failures",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Failure events per second. Remote-write failures count generated metric samples, not trace spans. Missing counters fall back to zero only with a healthy scrape.",
      "gridPos": {
        "x": 16,
        "y": 23,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(tempodb_compaction_errors_total{job=\"tempo\",namespace=~\"$namespace\",instance=~\"$instance\"}[$__rate_interval]))) or ((min(up{job=\"tempo\",namespace=~\"$namespace\",instance=~\"$instance\"}) == 1) * 0)",
          "legendFormat": "compaction",
          "range": true
        },
        {
          "refId": "B",
          "expr": "(sum(rate(tempodb_retention_errors_total{job=\"tempo\",namespace=~\"$namespace\",instance=~\"$instance\"}[$__rate_interval]))) or ((min(up{job=\"tempo\",namespace=~\"$namespace\",instance=~\"$instance\"}) == 1) * 0)",
          "legendFormat": "retention",
          "range": true
        },
        {
          "refId": "C",
          "expr": "(sum(rate(tempo_live_store_failed_completions_total{job=\"tempo\",namespace=~\"$namespace\",instance=~\"$instance\"}[$__rate_interval]))) or ((min(up{job=\"tempo\",namespace=~\"$namespace\",instance=~\"$instance\"}) == 1) * 0)",
          "legendFormat": "completion",
          "range": true
        },
        {
          "refId": "D",
          "expr": "(sum(rate(prometheus_remote_storage_samples_failed_total{job=\"tempo\",namespace=~\"$namespace\",instance=~\"$instance\"}[$__rate_interval]))) or ((min(up{job=\"tempo\",namespace=~\"$namespace\",instance=~\"$instance\"}) == 1) * 0)",
          "legendFormat": "remote-write samples",
          "range": true
        }
      ],
