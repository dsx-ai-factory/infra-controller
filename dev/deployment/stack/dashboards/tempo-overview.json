        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "title": "Discarded spans by reason",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Separate storage and metrics-generator drops. Zero fallback is used only with a healthy scrape; blank reason denotes no initialized discard counter.",
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum by(reason) (rate(tempo_discarded_spans_total{job=\"tempo\",namespace=~\"$namespace\",instance=~\"$instance\"}[$__rate_interval]))) or ((min(up{job=\"tempo\",namespace=~\"$namespace\",instance=~\"$instance\"}) == 1) * 0)",
          "legendFormat": "storage {{reason}}",
          "range": true
        },
        {
          "refId": "B",
          "expr": "(sum by(reason) (rate(tempo_metrics_generator_spans_discarded_total{job=\"tempo\",namespace=~\"$namespace\",instance=~\"$instance\"}[$__rate_interval]))) or ((min(up{job=\"tempo\",namespace=~\"$namespace\",instance=~\"$instance\"}) == 1) * 0)",
          "legendFormat": "generator {{reason}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "title": "Live-trace pressure",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Each instance's busiest tenant against the default live-trace cap. Positive limits only; per-tenant overrides require adapting this query.",
      "gridPos": {
        "x": 18,
        "y": 5,
        "w": 6,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "fillOpacity": 8,
            "showPoints": "never",
