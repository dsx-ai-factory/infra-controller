      "targets": [
        {
          "refId": "A",
          "expr": "sum by(instance) (rate(tempo_distributor_bytes_received_total{job=\"tempo\",namespace=~\"$namespace\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}",
          "range": true
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
