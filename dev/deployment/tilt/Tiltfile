    api_env = nico_api_values.setdefault('env', {})
    if not api_env.get('OTEL_EXPORTER_OTLP_TRACES_ENDPOINT'):
        api_env['OTEL_EXPORTER_OTLP_TRACES_ENDPOINT'] = 'http://tempo.%s.svc.cluster.local:4317' % observability_namespace
    bmc_proxy_values['configFiles']['nicoBmcProxyConfig'] += (
        '\n[tracing]\nenabled = true\notlp_endpoint = %s\n' %
        encode_json(api_env['OTEL_EXPORTER_OTLP_TRACES_ENDPOINT']).strip()
    )
    # Tilt runs the Kea hook, not the standalone DHCP server, DNS, or PXE.
    # Keep either explicit DHCP endpoint override ahead of the profile default.
    if not nico_dhcp_values.get('otlpEndpoint') and not nico_dhcp_values.get('env', {}).get('OTEL_EXPORTER_OTLP_TRACES_ENDPOINT'):
        nico_dhcp_values['otlpEndpoint'] = api_env['OTEL_EXPORTER_OTLP_TRACES_ENDPOINT']
    nico_api_dependencies.append('tempo')

