def merged(first, second):
    result = {}
    for key, value in first.items():
        result[key] = value
    for key, value in second.items():
        result[key] = value
    return result

def component_values(global_values, values):
    return merged({'global': global_values}, values)

def rest_trace_env(env, endpoint):
    result = merged({}, env)
    if not (result.get('OTEL_EXPORTER_OTLP_ENDPOINT') or result.get('OTEL_EXPORTER_OTLP_TRACES_ENDPOINT')):
        result['OTEL_EXPORTER_OTLP_ENDPOINT'] = endpoint
    if not (result.get('OTEL_EXPORTER_OTLP_PROTOCOL') or result.get('OTEL_EXPORTER_OTLP_TRACES_PROTOCOL')):
        result['OTEL_EXPORTER_OTLP_PROTOCOL'] = 'grpc'
    return result

def configure_rest_tracing(values, namespace):
    endpoint = 'http://tempo.%s.svc.cluster.local:4317' % namespace
    for component in ['api', 'certManager', 'siteManager']:
        component_config = values[component]
        component_config['extraEnv'] = rest_trace_env(component_config.get('extraEnv', {}), endpoint)
    values['siteAgent']['envConfig'] = rest_trace_env(values['siteAgent'].get('envConfig', {}), endpoint)
    for component in ['api', 'workflow']:
        values[component].setdefault('config', {}).setdefault('tracing', {})['enabled'] = True

    workflow = values['workflow']
    for worker, service in [('cloudWorker', 'nico-rest-cloud-worker'), ('siteWorker', 'nico-rest-site-worker')]:
        worker_config = workflow.setdefault(worker, {})
        # Resolve shared and worker settings before adding defaults: a worker
        # may override the shared endpoint using either OTLP endpoint variable.
        env = merged(workflow.get('extraEnv', {}), worker_config.get('extraEnv', {}))
        env = rest_trace_env(env, endpoint)
        if not env.get('OTEL_SERVICE_NAME') and not workflow['config']['tracing'].get('serviceName'):
            env['OTEL_SERVICE_NAME'] = service
        worker_config['extraEnv'] = env

def helm_json_flags(values, prefix=''):
    flags = []
    for key, value in values.items():
        escaped_key = key.replace('\\', '\\\\').replace('.', '\\.')
        path = '%s.%s' % (prefix, escaped_key) if prefix else escaped_key
        if type(value) == 'dict' and len(value):
            flags.extend(helm_json_flags(value, path))
        else:
            flags.extend(['--set-json', '%s=%s' % (path, encode_json(value))])
    return flags

def object_selector(obj):
    name = obj['metadata']['name']
    kind = obj['kind'].lower()
    namespace = obj['metadata'].get('namespace', '')
    if namespace:
        return '%s:%s:%s' % (name, kind, namespace)
    return '%s:%s' % (name, kind)

def local_prerequisites(name, template, dependencies=[], labels=['infrastructure']):
    # Keep the existing apply ownership; only manifest construction moves to Helm.
    # Splitting the render preserves namespace/operator/database readiness ordering.
    chart = os.path.join(repo_root, 'helm/nico-dev-prereqs')
    watch_file(chart)
    rendered = local(['helm', 'template', 'nico-dev-prereqs', chart,
                      '--values', '-', '--show-only', 'templates/' + template + '.yaml'],
                     stdin=encode_json(local_prereq_values), quiet=True)
    objects = [obj for obj in decode_yaml_stream(rendered) if obj]
    k8s_yaml(rendered)
    k8s_resource(new_name=name,
                 objects=[object_selector(obj) for obj in objects],
                 resource_deps=dependencies, labels=labels, pod_readiness='ignore')
    return objects


def helm_chart(
        name,
        chart,
        namespace,
        values,
        resource_deps=[],
        image_deps=[],
        image_keys=[],
        port_forwards=[],
        links=[],
        manual=False,
        wait=True,
        timeout='5m',
        values_files=[]):
    flags = ['--create-namespace'] + helm_json_flags(values)
    for path in values_files:
        flags.extend(['--values', path])
    if wait:
        flags.extend(['--wait', '--wait-for-jobs', '--timeout=%s' % timeout])
    helm_resource(
        name=name,
        chart=chart,
        release_name=name,
        namespace=namespace,
        deps=[chart, values_file] + values_files,
        resource_deps=resource_deps,
        image_deps=image_deps,
        image_keys=image_keys,
        labels=['application'],
        pod_readiness='wait' if wait else 'ignore',
        port_forwards=port_forwards,
        links=links,
        flags=flags,
    )
    if manual:
        k8s_resource(name, trigger_mode=TRIGGER_MODE_MANUAL)

def prerequisite(
        name,
        chart,
        release_name,
        namespace,
        version,
        values,
        repo,
        resource_deps=[],
        port_forwards=[],
        links=[],
        labels=['infrastructure']):
    helm_resource(
        name=name,
        chart=chart,
        release_name=release_name,
        namespace=namespace,
        deps=[values_file],
        resource_deps=[repo] + resource_deps,
        labels=labels,
        pod_readiness='wait',
        port_forwards=port_forwards,
        links=links,
        flags=[
            '--version=%s' % version,
            '--create-namespace',
        ] + helm_json_flags(values) + [
            '--wait',
            '--timeout=5m',
        ],
    )

def rest_image(name, dockerfile, only):
    docker_build(
        'localhost/%s' % name,
        rest_api_dir,
        dockerfile=os.path.join(rest_api_docker_local, dockerfile),
        platform=build_platform,
        only=only + [
            'go.mod',
            'go.sum',
            'sdk/standard/go.mod',
        ],
    )

