if enable_dpf:
    # nico-api compiles this namespace in (carbide_dpf::NAMESPACE); the
    # dpf-sim-controller manifests and the nico-api chart's
    # dpf.operatorNamespace default hardcode it too.
    if dpf_namespace != 'dpf-operator-system':
        fail('localConfig.dpfNamespace must stay dpf-operator-system')
    dpf_namespace_object = {
        'apiVersion': 'v1',
        'kind': 'Namespace',
        'metadata': {'name': dpf_namespace},
    }
    k8s_yaml(encode_yaml(dpf_namespace_object))
    k8s_resource(
        new_name='nico-dpf-namespace',
        objects=[object_selector(dpf_namespace_object)],
        labels=['dpf'],
        pod_readiness='ignore',
    )

    dpf_crd_objects = []
    for crd_file in sorted(listdir(dpf_crd_dir)):
        # Match the kubectl wait below, which only visits YAML/JSON files.
        if not crd_file.endswith('.yaml'):
            continue
        k8s_yaml(crd_file)
        for crd in decode_yaml_stream(read_file(crd_file)):
            if crd:
                dpf_crd_objects.append(object_selector(crd))
    k8s_resource(
        new_name='dpf-crds',
        objects=dpf_crd_objects,
        labels=['dpf'],
        pod_readiness='ignore',
    )
    # kubectl apply returns before discovery serves the new types, and nico-api
    # writes DPF custom resources at startup, so first-time deploys of
    # dependents wait until every CRD is established. resource_deps do not
    # gate re-deploys: enable this profile with a fresh `tilt up -- --dpf=true`.
    local_resource(
        'dpf-crds-ready',
        [
            'kubectl',
            'wait',
            '--for=condition=established',
            '--timeout=5m',
            '--filename=%s' % dpf_crd_dir,
        ],
        resource_deps=['dpf-crds'],
        labels=['dpf'],
    )

