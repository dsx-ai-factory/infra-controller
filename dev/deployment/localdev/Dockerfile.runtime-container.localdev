ARG CONTAINER_BASE_IMAGE=debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
FROM ${CONTAINER_BASE_IMAGE} AS kea-builder
ARG KEA_VERSION
COPY dev/docker/build-kea.sh dev/docker/kea-lease6-replacement.patch dev/docker/setup-kea-repository.sh dev/docker/isc-kea-3-0.asc /tmp/kea-build/
RUN /tmp/kea-build/build-kea.sh "${KEA_VERSION}"

FROM ${CONTAINER_BASE_IMAGE} AS carbide

ARG KEA_VERSION

COPY dev/docker/setup-kea-repository.sh dev/docker/isc-kea-3-0.asc dev/docker/configure-kea-runtime.sh /tmp/kea-repository/
RUN sh /tmp/kea-repository/setup-kea-repository.sh

ENV KEA_HOOKS_PATH=/usr/lib/kea/hooks

RUN mkdir -p /opt/carbide/migrations && \
  mkdir -p /opt/carbide/pxe/templates && \
  mkdir -p /opt/carbide/static \
  mkdir -p /forge-boot-artifacts/blobs/internal/aarch64


# This is required for kea pid file
RUN mkdir -p /var/run/kea

RUN --mount=type=cache,target=/var/cache/apt apt-get update && apt-get install -y --no-install-recommends \
  postgresql-client-15 \
  ca-certificates \
  curl \
  iproute2 \
  iputils-ping \
  isc-kea-common=${KEA_VERSION} \
  isc-kea-hooks=${KEA_VERSION} \
  isc-kea-dev=${KEA_VERSION} \
  isc-kea-dhcp4=${KEA_VERSION} \
  isc-kea-dhcp6=${KEA_VERSION} \
  libssl-dev \
  libudev1 \
  ca-certificates \
  curl \
  ipmitool \
  iproute2 \
  iputils-ping \
  libudev1 \
  tpm2-tools \
  nginx \
  libtss2-dev


COPY --from=kea-builder /kea-packages/isc-kea-common.deb /tmp/isc-kea-common.deb
RUN dpkg -i /tmp/isc-kea-common.deb && rm /tmp/isc-kea-common.deb

RUN sh /tmp/kea-repository/configure-kea-runtime.sh && rm -rf /tmp/kea-repository
