ARG CONTAINER_BUILD=nico-dev-build
ARG CONTAINER_RUNTIME=nico-dev-runtime

FROM ${CONTAINER_BUILD} AS source

ARG TARGETARCH

ENV CARGO_HOME=/cargo-home
ENV CARGO_NET_GIT_FETCH_WITH_CLI=true
ENV CARGO_TARGET_DIR=/cargo-target
ENV CARGO_PROFILE_DEV_DEBUG=line-tables-only
ENV CARGO_PROFILE_RELEASE_DEBUG=line-tables-only
# Release images receive this from CI (dev/docker/Dockerfile.release-*). The
# DPF DPUServiceTemplates nico-api writes at startup embed it as the services'
# Helm chart version, which the DPF CRDs require to be a non-empty semver tag.
# A static value keeps the Docker layer cache stable; nothing resolves the
# chart under the Tilt DPF simulator.
ARG CARBIDE_BUILD_HELM_VERSION=0.0.0-tilt
ENV CARBIDE_BUILD_HELM_VERSION=$CARBIDE_BUILD_HELM_VERSION

WORKDIR /workspace
COPY . .

# Keep large Rust binaries in the architecture-specific locked Cargo cache.
# Builder layers retain only digests; runtime copies fail if another build or
# cache eviction changed the expected artifact.
FROM source AS api-builder

RUN --mount=type=cache,id=nico-dev-cargo-home-${TARGETARCH},target=/cargo-home,sharing=locked \
    --mount=type=cache,id=nico-dev-cargo-target-${TARGETARCH},target=/cargo-target,sharing=locked \
    cargo build --locked \
    -p carbide-api --bin carbide-api \
    -p nico-admin-cli --bin nico-admin-cli \
    && mkdir -p /out \
    && sha256sum </cargo-target/debug/carbide-api >/out/carbide-api.sha256sum \
    && sha256sum </cargo-target/debug/nico-admin-cli >/out/nico-admin-cli.sha256sum

FROM source AS pxe-builder

RUN --mount=type=cache,id=nico-dev-cargo-home-${TARGETARCH},target=/cargo-home,sharing=locked \
    --mount=type=cache,id=nico-dev-cargo-target-${TARGETARCH},target=/cargo-target,sharing=locked \
    cargo build --locked -p carbide-pxe --bin carbide \
    && mkdir -p /out && sha256sum </cargo-target/debug/carbide >/out/carbide.sha256sum

FROM source AS bmc-proxy-builder

RUN --mount=type=cache,id=nico-dev-cargo-home-${TARGETARCH},target=/cargo-home,sharing=locked \
    --mount=type=cache,id=nico-dev-cargo-target-${TARGETARCH},target=/cargo-target,sharing=locked \
    cargo build --locked -p carbide-bmc-proxy --bin carbide-bmc-proxy \
    && mkdir -p /out \
    && sha256sum </cargo-target/debug/carbide-bmc-proxy >/out/carbide-bmc-proxy.sha256sum

FROM source AS dhcp-builder

RUN --mount=type=cache,id=nico-dev-cargo-home-${TARGETARCH},target=/cargo-home,sharing=locked \
    --mount=type=cache,id=nico-dev-cargo-target-${TARGETARCH},target=/cargo-target,sharing=locked \
    cargo build --locked -p carbide-dhcp --lib \
    && mkdir -p /out \
    && sha256sum </cargo-target/debug/libdhcp.so >/out/libdhcp.so.sha256sum

FROM source AS machine-a-tron-builder

RUN --mount=type=cache,id=nico-dev-cargo-home-${TARGETARCH},target=/cargo-home,sharing=locked \
    --mount=type=cache,id=nico-dev-cargo-target-${TARGETARCH},target=/cargo-target,sharing=locked \
    cargo build --locked -p carbide-machine-a-tron --bin machine-a-tron \
    && mkdir -p /out \
    && sha256sum </cargo-target/debug/machine-a-tron >/out/machine-a-tron.sha256sum

FROM source AS ssh-console-builder

RUN --mount=type=cache,id=nico-dev-cargo-home-${TARGETARCH},target=/cargo-home,sharing=locked \
    --mount=type=cache,id=nico-dev-cargo-target-${TARGETARCH},target=/cargo-target,sharing=locked \
    cargo build --locked -p carbide-ssh-console --bin ssh-console \
    && mkdir -p /out \
    && sha256sum </cargo-target/debug/ssh-console >/out/ssh-console.sha256sum

FROM source AS mat-protocol-gateway-builder

RUN --mount=type=cache,id=nico-dev-cargo-home-${TARGETARCH},target=/cargo-home,sharing=locked \
    --mount=type=cache,id=nico-dev-cargo-target-${TARGETARCH},target=/cargo-target,sharing=locked \
    cargo build --locked --release -p carbide-mat-protocol-gateway --bin mat-protocol-gateway \
    && mkdir -p /out \
    && sha256sum </cargo-target/release/mat-protocol-gateway >/out/mat-protocol-gateway.sha256sum

FROM source AS nico-postgres-exporter-builder

RUN --mount=type=cache,id=nico-dev-cargo-home-${TARGETARCH},target=/cargo-home,sharing=locked \
    --mount=type=cache,id=nico-dev-cargo-target-${TARGETARCH},target=/cargo-target,sharing=locked \
    cargo build --locked --release -p nico-postgres-exporter --bin nico-postgres-exporter \
    && mkdir -p /out \
    && sha256sum </cargo-target/release/nico-postgres-exporter >/out/nico-postgres-exporter.sha256sum

### Runtime layers

# api runtime image
FROM ${CONTAINER_RUNTIME} AS api

ARG TARGETARCH

RUN apt-get update && apt-get install -y --no-install-recommends \
  curl \
  ipmitool \
  iproute2 \
  iputils-ping \
  libudev1 \
  tpm2-tools \
  && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/carbide /opt/carbide/firmware /mnt/persistence /var/run/kea

COPY --from=api-builder /out/carbide-api.sha256sum /tmp/carbide-api.sha256sum

RUN --mount=type=cache,id=nico-dev-cargo-target-${TARGETARCH},target=/cargo-target,sharing=locked \
    cp /cargo-target/debug/carbide-api /opt/carbide/carbide-api \
    && test "$(sha256sum </opt/carbide/carbide-api)" = "$(cat /tmp/carbide-api.sha256sum)" \
    && rm /tmp/carbide-api.sha256sum
COPY --from=api-builder /out/nico-admin-cli.sha256sum /tmp/nico-admin-cli.sha256sum

RUN --mount=type=cache,id=nico-dev-cargo-target-${TARGETARCH},target=/cargo-target,sharing=locked \
    cp /cargo-target/debug/nico-admin-cli /opt/carbide/nico-admin-cli \
    && test "$(sha256sum </opt/carbide/nico-admin-cli)" = "$(cat /tmp/nico-admin-cli.sha256sum)" \
    && rm /tmp/nico-admin-cli.sha256sum
COPY crates/api/casbin-policy.csv /opt/carbide/casbin-policy.csv

ENV CASBIN_POLICY_FILE=/opt/carbide/casbin-policy.csv
ENV PATH /opt/carbide:$PATH

FROM ${CONTAINER_RUNTIME} AS bmc-proxy

ARG TARGETARCH

RUN mkdir -p /opt/carbide /mnt/persistence

COPY --from=bmc-proxy-builder /out/carbide-bmc-proxy.sha256sum /tmp/carbide-bmc-proxy.sha256sum

RUN --mount=type=cache,id=nico-dev-cargo-target-${TARGETARCH},target=/cargo-target,sharing=locked \
    cp /cargo-target/debug/carbide-bmc-proxy /opt/carbide/carbide-bmc-proxy \
    && test "$(sha256sum </opt/carbide/carbide-bmc-proxy)" = "$(cat /tmp/carbide-bmc-proxy.sha256sum)" \
    && rm /tmp/carbide-bmc-proxy.sha256sum

FROM ${CONTAINER_RUNTIME} AS dhcp

ARG TARGETARCH

ARG KEA_VERSION

RUN apt-get update && apt-get install -y --no-install-recommends \
  curl \
  iproute2 \
  kea-dhcp4-server=${KEA_VERSION} \
  kea-dhcp6-server=${KEA_VERSION} \
  && rm -rf /var/lib/apt/lists/*

# Reuse a dependency-provided Kea package from the native build image. Older
# build images retain the distribution package; they do not include lease-handoff fixes.
RUN --mount=type=bind,from=source,source=/opt,target=/build-opt,ro \
    if [ -f /build-opt/kea/kea-common.deb ]; then \
      test "$(dpkg-deb -f /build-opt/kea/kea-common.deb Package)" = kea-common && \
      test "$(dpkg-deb -f /build-opt/kea/kea-common.deb Version)" = "${KEA_VERSION}" && \
      test "$(dpkg-deb -f /build-opt/kea/kea-common.deb Architecture)" = "$(dpkg --print-architecture)" && \
      dpkg -i /build-opt/kea/kea-common.deb; \
    fi

RUN mkdir -p /usr/lib/kea/hooks /var/lib/kea /var/run/kea

COPY --from=dhcp-builder /out/libdhcp.so.sha256sum /tmp/libdhcp.so.sha256sum

RUN --mount=type=cache,id=nico-dev-cargo-target-${TARGETARCH},target=/cargo-target,sharing=locked \
    cp /cargo-target/debug/libdhcp.so /usr/lib/kea/hooks/libdhcp.so \
    && test "$(sha256sum </usr/lib/kea/hooks/libdhcp.so)" = "$(cat /tmp/libdhcp.so.sha256sum)" \
    && rm /tmp/libdhcp.so.sha256sum

FROM ${CONTAINER_RUNTIME} AS pxe

ARG TARGETARCH

RUN groupadd --gid 10001 nico \
    && useradd --uid 10001 --gid nico --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin nico \
    && install -d -o nico -g nico /opt/carbide/pxe/templates /opt/carbide/scout-firmware-scripts /forge-boot-artifacts/blobs
COPY --from=pxe-builder /out/carbide.sha256sum /tmp/carbide.sha256sum

RUN --mount=type=cache,id=nico-dev-cargo-target-${TARGETARCH},target=/cargo-target,sharing=locked \
    cp /cargo-target/debug/carbide /opt/carbide/carbide \
    && test "$(sha256sum </opt/carbide/carbide)" = "$(cat /tmp/carbide.sha256sum)" \
    && chown nico:nico /opt/carbide/carbide \
    && rm /tmp/carbide.sha256sum
COPY --chown=nico:nico pxe/templates/ /opt/carbide/pxe/templates/
COPY --chown=nico:nico pxe/scout-firmware-scripts/ /opt/carbide/scout-firmware-scripts/
USER 10001:10001

FROM ${CONTAINER_RUNTIME} AS machine-a-tron

ARG TARGETARCH

RUN apt-get update && apt-get install -y --no-install-recommends \
  ipmitool \
  iproute2 \
  iputils-ping \
  libssl3 \
  libudev1 \
  openipmi \
  && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/machine-a-tron/bin /tmp/machine-a-tron-data

COPY --from=machine-a-tron-builder /out/machine-a-tron.sha256sum /tmp/machine-a-tron.sha256sum

RUN --mount=type=cache,id=nico-dev-cargo-target-${TARGETARCH},target=/cargo-target,sharing=locked \
    cp /cargo-target/debug/machine-a-tron /opt/machine-a-tron/bin/machine-a-tron \
    && test "$(sha256sum </opt/machine-a-tron/bin/machine-a-tron)" = "$(cat /tmp/machine-a-tron.sha256sum)" \
    && rm /tmp/machine-a-tron.sha256sum
COPY crates/bmc-mock/dell_poweredge_r750.tar.gz /opt/machine-a-tron/dell_poweredge_r750.tar.gz
COPY crates/bmc-mock/nvidia_dpu.tar.gz /opt/machine-a-tron/nvidia_dpu.tar.gz

FROM ${CONTAINER_RUNTIME} AS ssh-console

ARG TARGETARCH

RUN apt-get update && apt-get install -y --no-install-recommends ipmitool libudev1 libssl3 \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/carbide

COPY --from=ssh-console-builder /out/ssh-console.sha256sum /tmp/ssh-console.sha256sum

RUN --mount=type=cache,id=nico-dev-cargo-target-${TARGETARCH},target=/cargo-target,sharing=locked \
    cp /cargo-target/debug/ssh-console /opt/carbide/ssh-console \
    && test "$(sha256sum </opt/carbide/ssh-console)" = "$(cat /tmp/ssh-console.sha256sum)" \
    && rm /tmp/ssh-console.sha256sum

FROM ${CONTAINER_RUNTIME} AS mat-protocol-gateway

ARG TARGETARCH

COPY --from=mat-protocol-gateway-builder /out/mat-protocol-gateway.sha256sum /tmp/mat-protocol-gateway.sha256sum

RUN --mount=type=cache,id=nico-dev-cargo-target-${TARGETARCH},target=/cargo-target,sharing=locked \
    cp /cargo-target/release/mat-protocol-gateway /mat-protocol-gateway \
    && test "$(sha256sum </mat-protocol-gateway)" = "$(cat /tmp/mat-protocol-gateway.sha256sum)" \
    && rm /tmp/mat-protocol-gateway.sha256sum

FROM ${CONTAINER_RUNTIME} AS nico-postgres-exporter

ARG TARGETARCH

COPY --from=nico-postgres-exporter-builder /out/nico-postgres-exporter.sha256sum /tmp/nico-postgres-exporter.sha256sum

RUN --mount=type=cache,id=nico-dev-cargo-target-${TARGETARCH},target=/cargo-target,sharing=locked \
    cp /cargo-target/release/nico-postgres-exporter /usr/local/bin/nico-postgres-exporter \
    && test "$(sha256sum </usr/local/bin/nico-postgres-exporter)" = "$(cat /tmp/nico-postgres-exporter.sha256sum)" \
    && rm /tmp/nico-postgres-exporter.sha256sum

USER 65534:65534
