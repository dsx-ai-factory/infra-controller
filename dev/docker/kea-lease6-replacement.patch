+// The DHCPv6 hook checks this native persistence contract before loading.
+extern "C" int nico_kea_lease6_handoff_contract() { return 1; }
+
 namespace {
+
+// A SELECT hook may redirect an allocation onto an existing lease only by
+// supplying the snapshot it explicitly approved. Keep that row until the
+// replacement write succeeds; an absent snapshot retains INSERT collision checks.
+bool persistLease6Replacement(AllocEngine::ClientContext6& ctx,
+                              const Lease6Ptr& lease, const Lease6Ptr& replacement,
+                              const bool response_fqdn) {
+    auto& leases = LeaseMgrFactory::instance();
+    if (!replacement) {
+        return (leases.addLease(lease));
+    }
+    if (replacement->addr_ != lease->addr_ || replacement->type_ != lease->type_ ||
+        replacement->subnet_id_ != lease->subnet_id_) {
+        isc_throw(isc::BadValue, "SELECT replacement must identify the selected lease");
+    }
+    const auto current = leases.getLease6(lease->type_, lease->addr_);
+    if (!current || *current != *replacement) {
+        isc_throw(isc::Unexpected, "SELECT replacement lease changed before persistence");
+    }
+    lease->current_cltt_ = replacement->cltt_;
+    lease->current_valid_lft_ = replacement->valid_lft_;
+    leases.updateLease6(lease);
+    if (response_fqdn && (lease->fqdn_fwd_ || lease->fqdn_rev_)) {
+        // Kea 3 checks DUID changes and chains REMOVE/ADD in one NCR. Preserve
+        // that native ordering contract, including for an unchanged hostname.
+        ctx.currentIA().changed_leases_.push_back(replacement);
+    } else {
+        // Without new DNS updates the response path may have no FQDN option.
+        // Remove the old ownership after persistence even in that case.
+        queueNCR(CHG_REMOVE, replacement);
+    }
+    return (true);
+}
 
