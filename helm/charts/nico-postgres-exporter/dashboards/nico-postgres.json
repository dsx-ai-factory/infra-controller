{
  "uid": "nico-postgres",
  "title": "NICo / PostgreSQL",
  "description": "PostgreSQL connectivity and cumulative slow-query statistics collected by the NICo exporter through Prometheus.",
  "tags": [
    "nico",
    "postgresql"
  ],
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "current": {
          "selected": false,
          "text": "Prometheus",
          "value": "prometheus"
        },
        "label": "Prometheus",
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "type": "datasource"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Exporter scrape health",
      "description": "1 means Prometheus can scrape the exporter; it does not prove the database connection.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "up{component=\"nico-postgres-exporter\"}",
          "instant": true,
          "range": false,
          "refId": "A",
          "legendFormat": "{{namespace}} / {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "PostgreSQL connection",
      "description": "1 means the latest SELECT 1 query succeeded. 0 means no successful probe yet, or the latest attempt failed or timed out.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "nico_postgres_exporter_database_up{component=\"nico-postgres-exporter\"} and on(namespace, instance) (up{component=\"nico-postgres-exporter\"} == 1)",
          "instant": true,
          "range": false,
          "refId": "A",
          "legendFormat": "{{namespace}} / {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Last successful database query",
      "description": "Time of the latest successful SELECT 1 query. Zero displays as Never until the first success; database failures preserve the timestamp.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "nico_postgres_exporter_last_success_timestamp_seconds{component=\"nico-postgres-exporter\"} * 1000",
          "instant": true,
          "range": false,
          "refId": "A",
          "legendFormat": "{{namespace}} / {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Never"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "dateTimeAsIso"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "none",
        "graphMode": "none"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Query statistics collection",
      "description": "1 means the latest pg_stat_statements snapshot succeeded. 0 means collection has not succeeded, failed, or timed out. Check extension setup and role permissions.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "targets": [
        {
          "expr": "nico_postgres_exporter_stat_statements_up{component=\"nico-postgres-exporter\"} and on(namespace, instance) (up{component=\"nico-postgres-exporter\"} == 1)",
          "instant": true,
          "range": false,
          "refId": "A",
          "legendFormat": "{{namespace}} / {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none"
      }
    },
    {
      "id": 5,
      "type": "table",
      "title": "Slow queries \u2014 top 20 by total execution time",
      "description": "Latest snapshot of pg_stat_statements across databases and roles: query, calls, total execution seconds, and average execution milliseconds. Cumulative since PostgreSQL statistics were reset or the entry was created; independent of the dashboard time range. Refreshed every 30 seconds. Failed collection clears the table after the next scrape. Query text may be redacted without pg_read_all_stats permission.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 15,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nico_postgres_statement_calls{component=\"nico-postgres-exporter\"} * 1 and on(namespace, instance) (up{component=\"nico-postgres-exporter\"} == 1)",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "nico_postgres_statement_exec_seconds{component=\"nico-postgres-exporter\"} * 1 and on(namespace, instance) (up{component=\"nico-postgres-exporter\"} == 1)",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "expr": "nico_postgres_statement_mean_exec_milliseconds{component=\"nico-postgres-exporter\"} * 1 and on(namespace, instance) (up{component=\"nico-postgres-exporter\"} == 1)",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "query",
                "Value #A",
                "Value #B",
                "Value #C"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "query": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3
            },
            "renameByName": {
              "query": "Query",
              "Value #A": "Calls",
              "Value #B": "Total execution (s)",
              "Value #C": "Average execution (ms)"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Total execution (s)",
                "desc": true
              }
            ]
          }
        },
        {
          "id": "limit",
          "options": {
            "limitField": 20
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Query"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 800
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Calls"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Total execution (s)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Average execution (ms)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ms"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Total execution (s)",
            "desc": true
          }
        ],
        "footer": {
          "show": false
        }
      }
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  }
}
