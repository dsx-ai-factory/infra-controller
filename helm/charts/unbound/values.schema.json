{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "externalService": {
      "type": "object",
      "properties": {
        "ipFamilyPolicy": {
          "enum": [
            null,
            "",
            "SingleStack",
            "PreferDualStack",
            "RequireDualStack"
          ]
        },
        "ipFamilies": {
          "type": [
            "array",
            "null"
          ],
          "uniqueItems": true,
          "items": {
            "enum": [
              "IPv4",
              "IPv6"
            ]
          }
        }
      }
    },
    "ipv6": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
