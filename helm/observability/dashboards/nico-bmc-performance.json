          "editorMode": "code",
          "expr": "sum(increase(${metric_prefix}_hardware_health_bmc_latency_ms_count{job=~\"$job\",http_response_status_code=~\"2.*\"}[5m])) / sum(increase(${metric_prefix}_hardware_health_bmc_latency_ms_count{job=~\"$job\"}[5m]))",
