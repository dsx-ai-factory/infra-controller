export TESTDB_USER=postgres
export TESTDB_PASSWORD=admin
export TESTDB_HOST=localhost

export RUSTC_WRAPPER=sccache
REPO_ROOT="$(git rev-parse --show-toplevel)"
export REPO_ROOT

# Native ARM64 builds use the repository's Clang driver wrapper so mold is
# selected without imposing linker flags on other build environments. Cross-
# build environments provide their own target-aware driver through the same
# Cargo environment variable.
case "$(uname -s):$(uname -m)" in
    Linux:aarch64|Linux:arm64)
        export CARGO_TARGET_AARCH64_UNKNOWN_LINUX_GNU_LINKER="${REPO_ROOT}/dev/linkers/clang-mold"
        ;;
esac

# required for sqlx::test harnesses.
export DATABASE_URL=postgresql://${TESTDB_USER}:${TESTDB_PASSWORD}@${TESTDB_HOST}

#create this file and put any local overrides you may need into it.
if [[ -f "./.local_envrc" ]]; then
    source ./.local_envrc
fi
