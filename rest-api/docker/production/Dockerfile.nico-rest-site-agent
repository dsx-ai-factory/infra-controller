# Empty unless CI passes its cached Go module downloads as the `gomodcache`
# build context, so other builds download every module from the proxy.
FROM scratch AS gomodcache

# Build stage
FROM --platform=$BUILDPLATFORM golang:1.27.3@sha256:f20d83a83e18dbd2a4714b8ffd4b30b287b6243962dd75608e86abcc63ba4efc AS builder

# Docker automatically provides these args during multi-platform builds
ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG VERSION=dev

# Set environment variables for cross-compilation
ENV CGO_ENABLED=0
ENV GOOS=$TARGETOS
ENV GOARCH=$TARGETARCH

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Copy go module files first for better caching
COPY go.mod go.sum ./
# Copy SDK go module files, required for maintaining separate go.mod for SDK
COPY sdk/standard/go.mod ./sdk/standard/
COPY scripts/go-mod-download.sh ./scripts/
# Download dependencies. `|` falls back to the regular proxy for anything the
# cached downloads are missing.
RUN --mount=type=bind,from=gomodcache,target=/go-mod-download \
    GOPROXY="file:///go-mod-download|$(go env GOPROXY)" sh scripts/go-mod-download.sh

# Copy source files
COPY site-agent/ ./site-agent/
COPY common/ ./common/
COPY site-manager/ ./site-manager/
COPY proto/ ./proto/
COPY site-workflow/ ./site-workflow/
COPY cert-manager/ ./cert-manager/

# Build site-agent
WORKDIR /workspace/site-agent
RUN VERSION=${VERSION} && \
    BUILD_TIME=$(date +"%Y-%m-%d %H:%M:%S") && \
    go build \
        -ldflags "-extldflags '-static' -w -s \
                  -X 'github.com/NVIDIA/infra-controller/rest-api/site-agent/pkg/metadata.Version=${VERSION}' \
                  -X 'github.com/NVIDIA/infra-controller/rest-api/site-agent/pkg/metadata.BuildTime=${BUILD_TIME}'" \
        -o /app/site-agent \
        ./cmd/site-agent

# Final stage
FROM nvcr.io/nvidia/distroless/go:v4.0.8 AS final

WORKDIR /app

# Copy binaries from builder
COPY --from=builder --chown=nvs:nvs /app/site-agent /app/site-agent

# Switch to non-root user
USER nvs

# Expose port
EXPOSE 8080

# Run the application
ENTRYPOINT ["/app/site-agent"]
