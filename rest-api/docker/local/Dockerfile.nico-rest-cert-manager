# Local development Dockerfile for nico-rest-cert-manager

# Build stage
FROM --platform=$BUILDPLATFORM golang:1.27.3@sha256:f20d83a83e18dbd2a4714b8ffd4b30b287b6243962dd75608e86abcc63ba4efc AS builder

# Docker automatically provides these args during multi-platform builds
ARG TARGETOS
ARG TARGETARCH
ARG VERSION=dev

# Set environment variables for cross-compilation
ENV CGO_ENABLED=0
ENV GOOS=$TARGETOS
ENV GOARCH=$TARGETARCH

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Copy go module files first for better caching
COPY go.mod go.sum ./
# Copy SDK go module files, required for maintaining separate go.mod for SDK
COPY sdk/standard/go.mod ./sdk/standard/
# Download dependencies
RUN go mod download

# Copy source files
COPY common/ ./common/
COPY cert-manager/ ./cert-manager/

# Build REST Cert Manager
WORKDIR /workspace/cert-manager
RUN VERSION=${VERSION} && \
    BUILD_TIME=$(date +"%Y-%m-%d %H:%M:%S") && \
    go build \
        -ldflags "-extldflags '-static' -w -s -X=github.com/NVIDIA/infra-controller/rest-api/cert-manager/pkg/core.Version=${VERSION}" \
        -o /app/cert-manager \
        ./cmd/cert-manager

# credsmgr is the binary's former name. The link keeps deployments that
# override the container command with /app/credsmgr starting.
RUN ln -s cert-manager /app/credsmgr

# Final stage
FROM nvcr.io/nvidia/distroless/go:v4.1.8@sha256:676c150ccfb5987f58bbee9accfa506d5519d4acf4252f799d311476a0a7f1b5 AS final

WORKDIR /app

# Copy the binary and its former name from builder. Copying the directory
# keeps the link a link instead of a second copy of the binary.
COPY --from=builder --chown=nvs:nvs /app/ /app/

# Switch to non-root user
USER nvs

# Expose port
EXPOSE 8080

# Run the application
ENTRYPOINT ["/app/cert-manager"]
