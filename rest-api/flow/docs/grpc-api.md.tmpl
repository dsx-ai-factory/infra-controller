{{- /* Blocks have no trailing newline; each new paragraph supplies its separator. */ -}}
{{- define "paragraph" -}}{{ printf "\n\n%s" (. | trim) }}{{- end -}}
{{- define "cell" -}}{{ regexReplaceAll "\\s+" . " " | trim | html | replace "+" "&#43;" | replace "|" "\\|" }}{{- end -}}
# Protocol Documentation
{{- template "paragraph" "<a name=\"top\"></a>" -}}
{{- template "paragraph" "## Table of Contents" -}}
{{- range .Files -}}
  {{- $fileName := .Name -}}
  {{- template "paragraph" (printf "- [%s](#%s)" (.Name | html) (.Name | anchor)) -}}
  {{- range .Messages -}}{{ printf "\n  - [%s](#%s)" (.LongName | html) (.FullName | anchor) }}{{- end -}}
  {{- range .Enums -}}{{ printf "\n  - [%s](#%s)" (.LongName | html) (.FullName | anchor) }}{{- end -}}
  {{- range .Extensions -}}{{ printf "\n  - [File-level Extensions](#%s-extensions)" ($fileName | anchor) }}{{- end -}}
  {{- range .Services -}}{{ printf "\n  - [%s](#%s)" (.Name | html) (.FullName | anchor) }}{{- end -}}
{{- end -}}
{{- printf "\n- [Scalar Value Types](#scalar-value-types)" -}}
{{- range .Files -}}
  {{- $fileName := .Name -}}
  {{- template "paragraph" (printf "<a name=\"%s\"></a>" (.Name | anchor)) -}}
  {{- template "paragraph" "<p align=\"right\"><a href=\"#top\">Top</a></p>" -}}
  {{- template "paragraph" (printf "## %s" (.Name | html)) -}}
  {{- if .Description -}}{{ template "paragraph" (.Description | html | replace "+" "&#43;") }}{{- end -}}
  {{- range .Messages -}}
    {{- template "paragraph" (printf "<a name=\"%s\"></a>" (.FullName | anchor)) -}}
    {{- template "paragraph" (printf "### %s" (.LongName | html)) -}}
    {{- if .Description -}}{{ template "paragraph" (.Description | html | replace "+" "&#43;") }}{{- end -}}
    {{- if .HasFields -}}
      {{- template "paragraph" "| Field | Type | Label | Description |\n| ----- | ---- | ----- | ----------- |" -}}
      {{- range .Fields -}}
        {{- printf "\n| %s | [%s](#%s) | %s | " (.Name | html) (.LongType | html) (.FullType | anchor) (.Label | html) -}}
        {{- if (index .Options "deprecated" | default false) -}}{{ printf "**Deprecated.** " }}{{- end -}}
        {{- template "cell" .Description -}}
        {{- if .DefaultValue -}}{{ printf " Default: " }}{{ template "cell" .DefaultValue }}{{- end -}}
        {{- printf " |" -}}
      {{- end -}}
    {{- end -}}
    {{- if .HasExtensions -}}
      {{- template "paragraph" "| Extension | Type | Base | Number | Description |\n| --------- | ---- | ---- | ------ | ----------- |" -}}
      {{- range .Extensions -}}
        {{- printf "\n| %s | %s | %s | %d | " (.Name | html) (.LongType | html) (.ContainingLongType | html) .Number -}}
        {{- template "cell" .Description -}}
        {{- if .DefaultValue -}}{{ printf " Default: " }}{{ template "cell" .DefaultValue }}{{- end -}}
        {{- printf " |" -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
  {{- range .Enums -}}
    {{- template "paragraph" (printf "<a name=\"%s\"></a>" (.FullName | anchor)) -}}
    {{- template "paragraph" (printf "### %s" (.LongName | html)) -}}
    {{- if .Description -}}{{ template "paragraph" (.Description | html | replace "+" "&#43;") }}{{- end -}}
    {{- template "paragraph" "| Name | Number | Description |\n| ---- | ------ | ----------- |" -}}
    {{- range .Values -}}
      {{- printf "\n| %s | %s | " (.Name | html) .Number -}}
      {{- template "cell" .Description -}}{{ printf " |" -}}
    {{- end -}}
  {{- end -}}
  {{- if .HasExtensions -}}
    {{- template "paragraph" (printf "<a name=\"%s-extensions\"></a>" ($fileName | anchor)) -}}
    {{- template "paragraph" "### File-level Extensions" -}}
    {{- template "paragraph" "| Extension | Type | Base | Number | Description |\n| --------- | ---- | ---- | ------ | ----------- |" -}}
    {{- range .Extensions -}}
      {{- printf "\n| %s | %s | %s | %d | " (.Name | html) (.LongType | html) (.ContainingLongType | html) .Number -}}
      {{- template "cell" .Description -}}
      {{- if .DefaultValue -}}{{ printf " Default: `" }}{{ template "cell" .DefaultValue }}{{ printf "`" }}{{- end -}}
      {{- printf " |" -}}
    {{- end -}}
  {{- end -}}
  {{- range .Services -}}
    {{- template "paragraph" (printf "<a name=\"%s\"></a>" (.FullName | anchor)) -}}
    {{- template "paragraph" (printf "### %s" (.Name | html)) -}}
    {{- if .Description -}}{{ template "paragraph" (.Description | html | replace "+" "&#43;") }}{{- end -}}
    {{- template "paragraph" "| Method Name | Request Type | Response Type | Description |\n| ----------- | ------------ | ------------- | ----------- |" -}}
    {{- range .Methods -}}
      {{- printf "\n| %s | [%s](#%s)" (.Name | html) (.RequestLongType | html) (.RequestFullType | anchor) -}}
      {{- if .RequestStreaming -}}{{ printf " stream" }}{{- end -}}
      {{- printf " | [%s](#%s)" (.ResponseLongType | html) (.ResponseFullType | anchor) -}}
      {{- if .ResponseStreaming -}}{{ printf " stream" }}{{- end -}}
      {{- printf " | " -}}{{ template "cell" .Description }}{{ printf " |" -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- template "paragraph" "## Scalar Value Types" -}}
{{- template "paragraph" "| .proto Type | Notes | C++ | Java | Python | Go | C# | PHP | Ruby |\n| ----------- | ----- | --- | ---- | ------ | -- | -- | --- | ---- |" -}}
{{- range .Scalars -}}
  {{- printf "\n| <a name=\"%s\" /> %s | " (.ProtoType | anchor) (.ProtoType | html) -}}
  {{- template "cell" .Notes }}{{ printf " | " -}}
  {{- template "cell" .CppType }}{{ printf " | " -}}
  {{- template "cell" .JavaType }}{{ printf " | " -}}
  {{- template "cell" .PythonType }}{{ printf " | " -}}
  {{- template "cell" .GoType }}{{ printf " | " -}}
  {{- template "cell" .CSharp }}{{ printf " | " -}}
  {{- template "cell" .PhpType }}{{ printf " | " -}}
  {{- template "cell" .RubyType }}{{ printf " |" -}}
{{- end -}}
{{- printf "\n" -}}
